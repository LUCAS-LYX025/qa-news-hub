# API 前缀（开发模式默认）
VITE_API_BASE_URL=/api/v1/qa-news

# 可选：本地大模型（OpenAI 兼容 /v1/chat/completions，如 Ollama）
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b

# 可选：关闭免费在线翻译（Google / MyMemory 回退）
# DISABLE_FREE_TRANSLATE=1

# 可选：DeepL API Free
# DEEPL_API_KEY=
# DEEPL_API_URL=

# 可选：百度翻译开放平台 https://fanyi-api.baidu.com/
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_KEY=
# BAIDU_TRANSLATE_URL=
